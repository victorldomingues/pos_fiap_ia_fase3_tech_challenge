# Cópia para `.env` (NUNCA commitar o `.env`).
MED_LLM_BACKEND=extractive          # extractive (sem GPU) | hf (Qwen + adaptador)
MED_USE_ADAPTER=true
MED_ADAPTER_DIR=./artifacts/qwen-qlora-adapter
MED_INDEX_DIR=./artifacts/chroma
MED_TOP_K=3
MED_MIN_CONFIDENCE=0.35
# Ativação explícita: requer índice construído com --with-public-sources.
MED_PUBLIC_RAG_ENABLED=false
MED_DATABASE_PATH=./data/sqlite/medical_assistant.sqlite3
MED_DB_BOOTSTRAP_TOKEN=

# LangSmith (desligado por padrão; use apenas com dados sintéticos/redigidos)
MED_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-ai-assistant
